{
  "compilerOptions": {
    "jsx": "react-jsx", // ← ВАЖНО: преобразует JSX
    "module": "ESNext", // ← ВАЖНО: будет ES модули, а не CommonJS
    "target": "ESNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@mui/material/*": ["./node_modules/@mui/material/*"]
    },
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom" // 👈 ДОБАВЬТЕ ЭТУ СТРОКУ
    ]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.ts", // ← Исключаем stories файлы!
    "**/*.stories.tsx" // ← И из сборки, и из проверки типов
  ]
}
